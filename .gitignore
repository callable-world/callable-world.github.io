# Результат локальной сборки Jekyll — в репозиторий не попадает.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
vendor/
Gemfile.lock

# Секреты. Приватный ключ App живёт в ~/.secrets/, но эта страховка нужна:
# один раз ключ уже был случайно положен в корень репозитория.
*.pem
*.key
.secrets/

# Рабочие инструкции: внутренние документы, репозиторий публичный.
CLAUDE.md
ИНСТРУКЦИЯ.md

# Черновики не публикуются Jekyll'ом, но и в историю их тащить незачем.
_drafts/*
!_drafts/ШАБЛОН-СТАТЬИ.md
